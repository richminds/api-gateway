# ============================================================================
# API Gateway — configuration template
#
#   cp .env.example .env    and fill in the values marked REQUIRED.
#
# Two prefixes, two concerns (the same split the sibling services use):
#
#   APIGW_*     how this service is EXPOSED — host, port, CORS, docs, logging
#   GATEWAY_*   what it FRONTS and TRUSTS — routes, validation, budgets
#
# Nothing here is committed: .gitignore ignores every .env variant and
# re-includes only this template.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# REQUIRED — where tokens are validated
# ────────────────────────────────────────────────────────────────────────────

# The gateway holds NO signing key and understands nothing about token format.
# It asks auth-service "who is this token?" via GET /auth/me, which already
# checks the signature, the expiry AND its own revocation list — so no extra
# endpoint was needed there.
#
# Point this DIRECTLY at auth-service, not back through this gateway's own
# /auth route: routing it through the gateway would make validating a request
# require validating a request.
GATEWAY_INTROSPECTION_URL=http://localhost:8100/auth/me

# How long one answer is trusted before asking again.
#
# This IS the revocation lag: a logged-out token keeps working for at most this
# long. It is also the load control — asking per request would put a network
# round trip in front of all platform traffic and make auth-service a hard
# dependency of every call. Halve it to make logout bite faster, and double
# auth-service's call volume.
GATEWAY_INTROSPECTION_CACHE_TTL_SECONDS=60

# How long a cached answer may still be used when auth-service is UNREACHABLE
# (never when it is merely stale). Keeps a brief auth-service outage from
# taking the whole platform down with it. 0 fails closed immediately.
#
# When nothing usable is cached the request fails with 502/504 — never
# admitted. Failing closed is deliberate: letting unvalidated traffic through
# because the validator is down turns an outage into an open front door.
GATEWAY_INTROSPECTION_STALE_GRACE_SECONDS=300

GATEWAY_INTROSPECTION_TIMEOUT_SECONDS=10


# ────────────────────────────────────────────────────────────────────────────
# Upstream services — the route table
# ────────────────────────────────────────────────────────────────────────────

# Comma-separated  name:prefix:base_url  entries. The prefix is stripped before
# forwarding, so /api/llm/v1/chat reaches llm-gateway as /v1/chat and the
# upstream needs no idea it is behind a gateway.
#
# Add a service here and it is reachable — no code change. The gateway
# implements nothing itself; auth-service is an ordinary upstream like the
# others, and signing in is an ordinary routed request.
#
# Note the auth entry's base_url carries a PATH ("/auth"). auth-service serves
# its routes under /auth, and the matched prefix is stripped before forwarding,
# so public "/auth/login" becomes "/login" and the base URL's path puts it back:
#   /auth/login  →  http://localhost:8100/auth/login
# That keeps the public path identical to what the UIs already call, so pointing
# them at the gateway is a base-URL change and nothing else.
GATEWAY_ROUTES=auth:/auth:http://localhost:8100/auth,llm:/api/llm:http://localhost:8080,knowledge:/api/knowledge:http://localhost:8090

# In Docker Compose, or any container network, use service names instead:
# GATEWAY_ROUTES=auth:/auth:http://auth-service:8100/auth,llm:/api/llm:http://llm-gateway:8080,knowledge:/api/knowledge:http://knowledge-service:8090

# The deployed services (Vercel). Note that only the auth entry carries a path:
# auth-service serves under /auth, the other two serve at their root.
# GATEWAY_ROUTES=auth:/auth:https://auth-service-zhx8.vercel.app/auth,llm:/api/llm:https://llm-gateway-theta.vercel.app,knowledge:/api/knowledge:https://knowledge-service-topaz.vercel.app

# Services sent the bearer token and NOTHING else — no X-User-ID, no
# X-Account-ID, no decomposed claim at all. auth-service is the identity
# authority: it reads the caller from a token it signed itself, so a second
# source of truth alongside that can only disagree with it. Caller-supplied
# identity headers are still stripped for these services — not injecting is
# not the same as passing through.
#
# Comma-separated GATEWAY_ROUTES entry NAMES, not path prefixes. Anything not
# listed gets the full set, so a newly routed service is served identity
# headers by default rather than silently going without them.
GATEWAY_IDENTITY_EXEMPT_SERVICES=auth


# ────────────────────────────────────────────────────────────────────────────
# Secured vs non-secured endpoints
# ────────────────────────────────────────────────────────────────────────────

# Which routed paths may be reached WITHOUT a token. Everything else requires a
# valid JWT — private by default, so a new endpoint on any upstream is protected
# the moment it exists and opening it up takes a deliberate edit here.
#
# Entry forms:
#   /auth/login          this exact path, any method
#   POST:/auth/login     this exact path, only via POST
#   /public/*            this path and everything beneath it
#
# A bare path is EXACT — it never matches by prefix. The wildcard is an explicit
# opt-in, because a rule like "/auth/* is public" is one new endpoint away from
# exposing /auth/users, and nothing errors when that happens.
#
# The default opens only what cannot possibly carry a token yet. Everything
# else auth-service exposes (/auth/me, /auth/logout, /auth/accounts, the staff
# routes) is routed like any other traffic and needs a token, with auth-service
# still enforcing its own rules on top.
GATEWAY_PUBLIC_PATHS=POST:/auth/login,POST:/auth/register,POST:/auth/organizations/register,POST:/auth/forgot-password,POST:/auth/reset-password

# Logout needs no configuration here. It is a routed request to auth-service
# like any other; auth-service revokes the token, and the gateway stops
# accepting it as soon as the cached validation above expires.

# Generous by default: an LLM completion or a document ingest legitimately runs
# for minutes, and a gateway that gives up first turns a slow success into a
# failed request.
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=120
# Kept short and separate — failing to REACH a service is a fast, unambiguous
# failure, and waiting two minutes to discover it helps nobody.
GATEWAY_UPSTREAM_CONNECT_TIMEOUT_SECONDS=5

# How much concurrency the gateway will push at the services behind it. The
# point of a shared front door is that it can protect them.
GATEWAY_UPSTREAM_MAX_CONNECTIONS=200
GATEWAY_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=50


# ────────────────────────────────────────────────────────────────────────────
# The gate
# ────────────────────────────────────────────────────────────────────────────

# Master switch. false = every route is public and no token is checked. Local
# smoke tests only — the gateway logs an error at startup when this is false in
# production.
GATEWAY_AUTH_ENABLED=true


# ────────────────────────────────────────────────────────────────────────────
# Rate limiting — requests per minute, sliding 60-second window
# ────────────────────────────────────────────────────────────────────────────

GATEWAY_RATE_LIMIT_ENABLED=true

# Two dimensions, both enforced, because they stop different failure modes:
# the per-user budget stops one runaway client hurting their own colleagues,
# the per-account budget stops one tenant crowding out the platform.
# 0 disables that dimension.
GATEWAY_USER_RPM=120
GATEWAY_ACCOUNT_RPM=1200

# Per client IP, for sign-in and sign-up — the only key that exists before a
# user does, and what makes password guessing expensive. Keep it low.
GATEWAY_ANONYMOUS_RPM=30

# Per-principal exceptions, comma-separated key=rpm. The key is matched against
# whichever dimension is being checked, so an account_id raises that account's
# ceiling and a user_id raises that user's.
# GATEWAY_RATE_LIMIT_OVERRIDES=acme-corp=6000,svc-batch-loader=600

# NOTE: budgets are per process. With N replicas each enforces its own window,
# so divide the intended global budget by N.


# ────────────────────────────────────────────────────────────────────────────
# Usage metering — cumulative request counts per user and per account
# ────────────────────────────────────────────────────────────────────────────

# Distinct from rate limiting: the limiter enforces a rolling minute and
# forgets, this keeps the totals behind GET /v1/usage.
GATEWAY_USAGE_TRACKING_ENABLED=true

# Counters are buffered and flushed on this interval rather than written per
# request, which would add a database round trip to every proxied call. A hard
# crash loses at most this many seconds of counts.
GATEWAY_USAGE_FLUSH_SECONDS=10


# ────────────────────────────────────────────────────────────────────────────
# Storage — OPTIONAL
# ────────────────────────────────────────────────────────────────────────────

# Two things need this: the usage counters and the shared identity cache below.
# Leave empty and both stay in process — correct for a SINGLE replica, and they
# reset on restart. Set it for anything with more than one replica, otherwise
# each replica reports only the traffic it personally handled and warms its own
# copy of the identity cache, which multiplies auth-service's load by the
# replica count instead of dividing it.
#
# On Vercel this is NOT set in vercel.json — that file is committed. Set it in
# the project's Environment Variables (Settings → Environment Variables), which
# is the only place a connection string belongs.
GATEWAY_MONGO_URI=
GATEWAY_MONGO_DB_NAME=api_gateway
GATEWAY_USAGE_COLLECTION=gateway_usage

# The cross-replica identity cache (features/identity_cache.py) — the second
# tier in front of auth-service. The in-process cache is per replica, so with N
# of them auth-service sees N times the traffic the TTL was meant to buy; this
# collapses that back to one call per token per TTL for the whole deployment.
#
# It has no TTL of its own. It reuses GATEWAY_INTROSPECTION_CACHE_TTL_SECONDS
# and GATEWAY_INTROSPECTION_STALE_GRACE_SECONDS above, and a MongoDB TTL index
# expires each document at TTL + grace. Documents are keyed by a SHA-256 of the
# token, never the token itself, and carry the user_id and account_id (both
# indexed, so a user or a whole account can be invalidated in one call).
#
# Needs GATEWAY_MONGO_URI. Without one this is inactive and the in-process
# cache is the whole cache, which is fine for a single replica.
GATEWAY_IDENTITY_CACHE_ENABLED=true
GATEWAY_IDENTITY_CACHE_COLLECTION=gateway_identity_cache


# ────────────────────────────────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────────────────────────────────

APIGW_HOST=0.0.0.0
# The front door. The services behind it keep their own ports (llm-gateway
# 8080, knowledge-service 8090, auth-service 8100) and in a real deployment
# only this one is reachable from outside.
APIGW_PORT=8000

# development | staging | production. Production turns the startup warnings
# about an unsafe configuration into errors, and disables uvicorn's reloader.
APIGW_ENVIRONMENT=development

APIGW_LOG_LEVEL=INFO
# json (default) — one JSON object per line, what every log aggregator parses
# natively. text — the plain format, for a human reading a terminal live.
APIGW_LOG_FORMAT=json

# Set when behind a path-prefixing proxy (e.g. an ALB serving this at /api).
APIGW_ROOT_PATH=

# Swagger at /docs. Consider false when the gateway is internet-facing.
APIGW_DOCS_ENABLED=true

# Expose resolved, non-secret configuration on GET /v1/config (staff-only
# either way). Never includes the JWT secret or the Mongo URI.
APIGW_EXPOSE_CONFIG_ENDPOINT=true

APIGW_REQUEST_ID_HEADER=X-Request-ID

# Whether to believe an inbound X-Forwarded-For when identifying the client IP
# for anonymous rate limiting.
#
# Leave FALSE unless a load balancer you control sits in front and overwrites
# the header. If the gateway is exposed directly, anyone can send that header
# and rotate a fake IP per request — which turns the sign-in rate limit into
# no rate limit at all.
APIGW_TRUST_FORWARDED_FOR=false


# ────────────────────────────────────────────────────────────────────────────
# CORS — browsers only
# ────────────────────────────────────────────────────────────────────────────
#
# This matters more here than in any other service: the gateway is the ONLY
# origin a browser app talks to, so an origin missing here means that UI is
# broken, and no configuration on the services behind it will help.

# Comma-separated exact origins.
APIGW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Vercel gives every deployment and preview its own hostname, so an exact
# allowlist goes stale on each deploy. A regex covers the whole family —
# anchor it to projects you actually own, never leave it open.
# APIGW_CORS_ORIGIN_REGEX=^https://(account-management|knowledge-ingest-ui)[a-z0-9-]*\.vercel\.app$

# Note: "*" is useless here. Every call carries an Authorization header, and
# browsers refuse a wildcard origin on a credentialed request — it does not
# loosen anything, it silently blocks everything.
